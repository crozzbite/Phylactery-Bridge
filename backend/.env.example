# ============================================================
# Backend (NestJS) — Local Development Defaults
# ============================================================
# Copy to backend/.env for local development. Production values
# are delivered out-of-band (see Phase 8 placeholders in
# openspec/changes/hardening-baseline/tasks.md).

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- CORS (hardening) ----
# Comma-separated list of allowed origins.
# DEV defaults: Angular dev server (4200) + Ionic dev server (8100).
# Validation: when NODE_ENV=production, env.schema.ts REJECTS empty values
# and any "*" entry.
CORS_ALLOWED_ORIGINS=http://localhost:8100,http://localhost:4200

# ---------------------------------------------------------------
# TODO: production allowed origins to be confirmed
# ---------------------------------------------------------------
# Replace the line below with the canonical frontend origin(s)
# before flipping NODE_ENV=production for real traffic.
# Example placeholder shape:
# CORS_ALLOWED_ORIGINS=https://app.skullrender.com,https://www.skullrender.com
# ---------------------------------------------------------------

# Legacy CORS knob still consumed by backend/src/main.ts until Phase 4
# replaces it. Keep aligned with CORS_ALLOWED_ORIGINS for now.
ALLOWED_ORIGINS=http://localhost:8100,http://localhost:4200

# ---- API Documentation gating (hardening) ----
# DOCS_ENABLED defaults to false. Phase 4 will gate Swagger setup behind it.
# In production, leave DOCS_ENABLED unset or set to "false" by default.
DOCS_ENABLED=true
DOCS_PATH=api/docs

# ---- Database ----
DATABASE_URL="postgresql://phy:phy_password@localhost:5432/phy_bridge?schema=public"

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- JWT (legacy, retained for compatibility) ----
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# ---- Firebase Admin (server-side credentials) ----
FIREBASE_PROJECT_ID=phylactery-bridge
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@phylactery-bridge.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://phylactery-bridge.firebaseio.com

# ---- Stripe (deferred to Sprint 6 — keep placeholders, module commented out) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- AI Engine (PHY) ----
PHY_ENGINE_URL=http://localhost:8000
PHY_API_KEY=phy_api_key_for_bridge
